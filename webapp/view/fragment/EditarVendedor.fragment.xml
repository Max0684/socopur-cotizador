<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:form="sap.ui.layout.form">
	<Dialog
		id="dlgEditarVendedor"
		title="{= ${adm>/esNuevo} ? ${i18n>vendAdmNuevo} : ${i18n>vendAdmEditar} }"
		contentWidth="38rem"
		draggable="true"
		resizable="true">
		<content>
			<form:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanM="4" labelSpanL="4" columnsM="1" columnsL="1">
				<Label text="{i18n>vendAdmEmpleado}" visible="{= ${adm>/esNuevo} &amp;&amp; ${adm>/conBusqueda} }" />
				<VBox visible="{= ${adm>/esNuevo} &amp;&amp; ${adm>/conBusqueda} }">
					<Select selectedKey="{adm>/sociedad}" items="{adm>/opcSociedad}" forceSelection="false" change=".onCambiaSociedad" class="sapUiTinyMarginBottom">
						<core:Item key="" text="{i18n>vendAdmTodasSociedades}" />
						<core:Item key="{adm>key}" text="{adm>text}" />
					</Select>
					<SearchField value="{adm>/busquedaEmpleado}" placeholder="{i18n>vendAdmEmpleadoBuscar}" liveChange=".onBuscarEmpleado" search=".onBuscarEmpleado" />
					<List mode="SingleSelectMaster" items="{adm>/empleados}" selectionChange=".onEmpleadoElegido" noDataText="{i18n>vendAdmEmpleadoNinguno}" growing="false">
						<StandardListItem title="{adm>nombre}" description="{adm>pernr} &#183; {adm>sociedad}" />
					</List>
				</VBox>
				<Label text="{i18n>vendAdmPernr}" required="true" />
				<Input value="{adm>/edicion/pernr}" maxLength="8" enabled="{= ${adm>/esNuevo} &amp;&amp; !${adm>/conBusqueda} }" />
				<Label text="{i18n>vendAdmNombre}" required="true" />
				<Input value="{adm>/edicion/nombre}" maxLength="40" />
				<Label text="{i18n>vendAdmTipo}" required="true" />
				<Select selectedKey="{adm>/edicion/tipo}" enabled="{adm>/esNuevo}" change=".onCambiaTipo">
					<core:Item key="repuestos" text="{i18n>tipoRepuestos}" />
					<core:Item key="vehiculos" text="{i18n>tipoVehiculos}" />
				</Select>
				<Label text="{i18n>vendAdmCiudad}" required="true" />
				<Select selectedKey="{adm>/ciudad}" forceSelection="false" items="{adm>/opcCiudad}" change=".onCambiaCiudad">
					<core:Item key="{adm>key}" text="{adm>text}" />
				</Select>
				<Label text="{i18n>vendAdmOrgVentas}" required="true" />
				<Select selectedKey="{adm>/edicion/vkorg}" enabled="{adm>/esNuevo}" items="{adm>/opcOrg}" change=".onCambiaArea">
					<core:Item key="{adm>key}" text="{adm>text}" />
				</Select>
				<Label text="{i18n>vendAdmCanal}" required="true" />
				<Select selectedKey="{adm>/edicion/vtweg}" items="{mock>/opciones/canales}" change=".onCambiaArea">
					<core:Item key="{mock>key}" text="{mock>text}" />
				</Select>
				<Label text="{i18n>vendAdmOficina}" />
				<Select selectedKey="{adm>/edicion/vkbur}" forceSelection="false" items="{adm>/opcOficina}">
					<core:Item key="{adm>key}" text="{adm>text}" />
				</Select>
				<Label text="{i18n>vendAdmCentro}" required="true" />
				<Select selectedKey="{adm>/edicion/werks}" forceSelection="false" items="{adm>/opcCentro}" change=".onCambiaCentro">
					<core:Item key="{adm>key}" text="{adm>text}" />
				</Select>
				<Label text="{i18n>vendAdmAlmacen}" />
				<Select selectedKey="{adm>/edicion/lgort}" forceSelection="false" items="{adm>/opcAlmacen}">
					<core:Item key="{adm>key}" text="{adm>text}" />
				</Select>
				<Label text="{i18n>vendAdmFormaPago}" />
				<Select selectedKey="{adm>/edicion/zterm}" forceSelection="false" items="{mock>/formasPago}">
					<core:Item key="{mock>key}" text="{mock>text}" />
				</Select>
				<Label text="{i18n>vendAdmExpedicion}" />
				<Select selectedKey="{adm>/edicion/vsbed}" forceSelection="false" items="{mock>/opciones/expediciones}">
					<core:Item key="{mock>key}" text="{mock>text}" />
				</Select>
				<Label text="{i18n>vendAdmMoneda}" />
				<Select selectedKey="{adm>/edicion/waers}">
					<core:Item key="PEN" text="PEN" />
					<core:Item key="USD" text="USD" />
				</Select>
				<Label text="{i18n>vendAdmVigencia}" />
				<StepInput value="{adm>/edicion/vigenciaDias}" min="1" max="90" width="8rem" />
				<Label text="{i18n>vendAdmRol}" />
				<Select selectedKey="{adm>/edicion/rol}">
					<core:Item key="V" text="{i18n>vendAdmRolV}" />
					<core:Item key="A" text="{i18n>vendAdmRolA}" />
				</Select>
				<Label text="{i18n>vendAdmNuevoPin}" />
				<Input type="Password" value="{adm>/nuevoPin}" maxLength="12" placeholder="{i18n>vendAdmPinVacio}" />
			</form:SimpleForm>
		</content>
		<beginButton>
			<Button text="{i18n>guardar}" type="Emphasized" press=".onGuardarVendedor" />
		</beginButton>
		<endButton>
			<Button text="{i18n>cerrar}" press=".onCerrarEdicion" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
