<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<Dialog
		id="dlgVendedor"
		title="{i18n>vendIdTitulo}"
		contentWidth="30rem"
		draggable="false"
		resizable="false"
		escapeHandler=".onVendedorEscape">
		<content>
			<VBox class="sapUiSmallMargin">
				<MessageStrip text="{i18n>vendIdNota}" type="Information" showIcon="true" class="sapUiSmallMarginBottom" />
				<SearchField
					id="vendBuscar"
					placeholder="{i18n>vendIdBuscar}"
					liveChange=".onVendedorBuscar"
					search=".onVendedorBuscar"
					class="sapUiTinyMarginBottom" />
				<List
					id="vendLista"
					mode="SingleSelectMaster"
					items="{vend>/visibles}"
					noDataText="{i18n>vendIdNinguno}"
					selectionChange=".onVendedorElegido"
					class="sapUiSmallMarginBottom">
					<StandardListItem
						title="{vend>nombre}"
						description="{vend>pernr} · {vend>tipo} · {vend>vkorg} · {vend>werks}"
						icon="sap-icon://person-placeholder" />
				</List>
				<MessageStrip text="{i18n>vendIdSinPin}" type="Warning" showIcon="true" visible="{vend>/sinPin}" class="sapUiSmallMarginBottom" />
				<MessageStrip text="{i18n>vendIdCrearPinNota}" type="Information" showIcon="true" visible="{vend>/crearPin}" class="sapUiSmallMarginBottom" />
				<HBox alignItems="Center" visible="{= !!${vend>/elegido} }">
					<Label text="{= ${vend>/crearPin} ? ${i18n>vendIdCrearPin} : ${i18n>vendIdPin} }" labelFor="vendPin" class="sapUiSmallMarginEnd" visible="{vend>/pedirPin}" />
					<Input id="vendPin" type="Password" width="12rem" value="{vend>/pin}" visible="{vend>/pedirPin}" valueState="{vend>/estadoPin}" valueStateText="{vend>/textoPin}" submit=".onVendedorEntrar" />
				</HBox>
				<HBox alignItems="Center" visible="{vend>/crearPin}" class="sapUiTinyMarginTop">
					<Label text="{i18n>vendIdRepitePin}" labelFor="vendPin2" class="sapUiSmallMarginEnd" />
					<Input id="vendPin2" type="Password" width="12rem" value="{vend>/pin2}" valueState="{vend>/estadoPin2}" valueStateText="{i18n>vendIdPinNoCoincide}" submit=".onVendedorEntrar" />
				</HBox>
			</VBox>
		</content>
		<beginButton>
			<Button text="{i18n>vendIdEntrar}" type="Emphasized" enabled="{= !!${vend>/elegido} &amp;&amp; !${vend>/sinPin} }" press=".onVendedorEntrar" />
		</beginButton>
		<endButton>
			<Button text="{i18n>vendIdCancelar}" press=".onVendedorCancelar" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
