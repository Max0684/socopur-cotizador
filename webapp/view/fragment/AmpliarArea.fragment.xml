<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:form="sap.ui.layout.form">
	<Dialog
		id="dlgAmpliar"
		title="{i18n>ampliarTitulo}"
		contentWidth="36rem"
		draggable="true"
		resizable="true">
		<content>
			<VBox class="sapUiSmallMargin">
				<MessageStrip text="{i18n>ampliarNota}" type="Information" showIcon="true" class="sapUiSmallMarginBottom" />
				<Title text="{i18n>areasVenta}" level="H4" class="sapUiTinyMarginBottom" />
				<List items="{cli>/areas}" noDataText="{i18n>areasNinguna}" class="sapUiSmallMarginBottom">
					<StandardListItem title="{cli>text}" icon="sap-icon://business-by-design" />
				</List>
				<!-- Ampliacion retail en SAP (regla de ZSDSCPP002): solo con el servicio publicado y un cliente de SAP. -->
				<VBox visible="{= !!${cli>/retail/visible} }" busy="{= !!${cli>/retail/cargando} }" busyIndicatorDelay="0" class="sapUiSmallMarginBottom">
					<Title text="{i18n>ampliarRetailTitulo}" level="H4" class="sapUiTinyMarginBottom" />
					<MessageStrip text="{cli>/retail/estadoTexto}" type="{cli>/retail/estadoTipo}" showIcon="true" visible="{= !!${cli>/retail/estadoTexto} }" class="sapUiTinyMarginBottom" />
					<Text text="{cli>/retail/resumen}" class="sapUiTinyMarginBottom" />
					<List items="{cli>/retail/grupos}" visible="{= ${cli>/retail/grupos}.length > 0 }" class="sapUiTinyMarginBottom">
						<StandardListItem title="{cli>titulo}" description="{cli>sectores}" icon="sap-icon://add" />
					</List>
					<Button text="{i18n>ampliarRetailAccion}" icon="sap-icon://action" enabled="{= !!${cli>/retail/puede} }" press=".onAmpliarRetail" />
				</VBox>
				<Title text="{i18n>ampliarOtrasTitulo}" level="H4" visible="{= !!${cli>/retail/visible} }" class="sapUiTinyMarginBottom" />
				<HBox alignItems="Center" wrap="Wrap">
					<Label text="{i18n>ampliarNueva}" class="sapUiSmallMarginEnd" />
					<Select selectedKey="{cli>/nueva}" forceSelection="false" width="20rem" items="{cli>/disponibles}" class="cotizAnchoMax">
						<layoutData><FlexItemData styleClass="cotizAnchoMax" /></layoutData>
						<core:Item key="{cli>key}" text="{cli>text}" />
					</Select>
				</HBox>
			</VBox>
		</content>
		<beginButton>
			<Button text="{i18n>ampliarAccion}" type="Emphasized" enabled="{= !!${cli>/nueva} }" press=".onAmpliarArea" />
		</beginButton>
		<endButton>
			<Button text="{i18n>cerrar}" press=".onCerrarCliente" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
