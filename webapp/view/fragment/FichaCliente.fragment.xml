<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:form="sap.ui.layout.form">
	<Dialog
		id="dlgFicha"
		stretch="{= ${device>/ancho} &lt; 600 }"
		title="{i18n>fichaTitulo}"
		contentWidth="46rem"
		draggable="true"
		resizable="true">
		<content>
			<VBox class="sapUiSmallMargin">
				<form:SimpleForm editable="false" layout="ColumnLayout" columnsM="1" columnsL="2" columnsXL="2">
					<Label text="{i18n>nombreCliente}" />
					<Text text="{cli>/nombre}" />
					<Label text="{i18n>documento}" />
					<Text text="{cli>/tipoDoc} {cli>/doc}" />
					<Label text="{i18n>condicionComercial}" />
					<Text text="{cli>/condicion}" />
					<Label text="{i18n>grupoCliente}" />
					<Text text="{cli>/grupo}" />
					<Label text="{i18n>telefono}" />
					<Text text="{cli>/telefono}" />
					<Label text="{i18n>correo}" />
					<Text text="{cli>/correo}" />
					<Label text="{i18n>direccion}" />
					<Text text="{cli>/direccion}" />
					<Label text="{i18n>estadoCliente}" />
					<ObjectStatus text="{cli>/estado}" state="{cli>/estadoState}" />
				</form:SimpleForm>
				<Title text="{i18n>direccionesTitulo}" level="H4" class="sapUiSmallMarginBottom" />
				<List items="{cli>/direcciones}" class="sapUiSmallMarginBottom">
					<StandardListItem title="{cli>alias}" description="{cli>texto}" icon="sap-icon://addresses" />
				</List>
				<Title text="{i18n>historialTitulo}" level="H4" class="sapUiSmallMarginBottom" visible="{= ${cli>/cambios}.length > 0 }" />
				<!-- En un telefono quedan fecha y campo; usuario, antes y despues bajan debajo de la fila -->
				<Table items="{cli>/cambios}" visible="{= ${cli>/cambios}.length > 0 }" class="sapUiSmallMarginBottom" contextualWidth="Auto">
					<columns>
						<Column width="7rem"><Text text="{i18n>historialFecha}" /></Column>
						<Column width="8rem" minScreenWidth="40rem" demandPopin="true"><Text text="{i18n>historialUsuario}" /></Column>
						<Column><Text text="{i18n>historialCampo}" /></Column>
						<Column minScreenWidth="40rem" demandPopin="true"><Text text="{i18n>historialAntes}" /></Column>
						<Column minScreenWidth="40rem" demandPopin="true"><Text text="{i18n>historialDespues}" /></Column>
					</columns>
					<items>
						<ColumnListItem>
							<cells>
								<Text text="{cli>fecha}" />
								<Text text="{cli>usuario}" />
								<Text text="{cli>campo}" />
								<Text text="{cli>antes}" />
								<Text text="{cli>despues}" />
							</cells>
						</ColumnListItem>
					</items>
				</Table>
				<Title text="{i18n>areasVenta}" level="H4" class="sapUiSmallMarginBottom" />
				<List items="{cli>/areas}" noDataText="{i18n>areasNinguna}">
					<StandardListItem title="{cli>text}" icon="sap-icon://business-by-design" />
				</List>
			</VBox>
		</content>
		<endButton>
			<Button text="{i18n>cerrar}" press=".onCerrarCliente" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
