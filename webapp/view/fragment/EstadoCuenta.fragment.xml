<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:form="sap.ui.layout.form">
	<Dialog
		id="dlgEstadoCuenta"
		title="{i18n>cuentaTitulo}"
		contentWidth="46rem"
		draggable="true"
		resizable="true">
		<content>
			<VBox class="sapUiSmallMargin">
				<HBox wrap="Wrap" class="sapUiSmallMarginBottom">
					<ObjectStatus title="{i18n>cuentaLinea}" text="{cli>/linea}" class="sapUiMediumMarginEnd" />
					<ObjectStatus title="{i18n>cuentaSaldo}" text="{cli>/saldo}" class="sapUiMediumMarginEnd" />
					<ObjectStatus title="{i18n>cuentaDisponible}" text="{cli>/disponible}" state="Success" class="sapUiMediumMarginEnd" />
					<ObjectStatus title="{i18n>cuentaVencido}" text="{cli>/vencido}" state="{cli>/vencidoEstado}" />
				</HBox>
				<MessageStrip text="{i18n>cuentaSimulada}" type="Information" showIcon="true" class="sapUiSmallMarginBottom" visible="{= !${cli>/real} }" />
				<MessageStrip text="{i18n>cuentaReal}" type="Information" showIcon="true" class="sapUiSmallMarginBottom" visible="{= !!${cli>/real} }" />
				<Table items="{cli>/segmentos}" visible="{= !!${cli>/real} }" class="sapUiSmallMarginBottom">
					<headerToolbar>
						<Toolbar><Title text="{i18n>credSegmentos}" level="H4" /></Toolbar>
					</headerToolbar>
					<columns>
						<Column width="6rem"><Text text="{i18n>credSegmento}" /></Column>
						<Column hAlign="End"><Text text="{i18n>credLimite}" /></Column>
						<Column><Text text="{i18n>credVigenciaHasta}" /></Column>
						<Column><Text text="{i18n>colEstado}" /></Column>
					</columns>
					<items>
						<ColumnListItem>
							<cells>
								<Text text="{cli>segmento}" />
								<ObjectNumber number="{cli>limite}" unit="PEN" />
								<Text text="{cli>vigencia}" />
								<ObjectStatus text="{cli>estado}" state="{cli>estadoState}" />
							</cells>
						</ColumnListItem>
					</items>
				</Table>
				<Table items="{cli>/movimientos}" noDataText="{i18n>cuentaSinMovimientos}">
					<columns>
						<Column width="7rem"><Text text="{i18n>colFecha}" /></Column>
						<Column><Text text="{i18n>cuentaDocumento}" /></Column>
						<Column width="8rem" hAlign="End"><Text text="{i18n>colTotalLinea}" /></Column>
						<Column width="8rem"><Text text="{i18n>colEstado}" /></Column>
					</columns>
					<items>
						<ColumnListItem>
							<cells>
								<Text text="{cli>fecha}" />
								<ObjectIdentifier title="{cli>doc}" text="{cli>tipo}" />
								<ObjectNumber number="{cli>monto}" unit="{= ${cli>moneda} || 'PEN' }" />
								<ObjectStatus text="{cli>estado}" state="{= ${cli>estado} === 'Pagada' || ${cli>estado} === 'Compensada' ? 'Success' : ${cli>estado} === 'Vencida' ? 'Error' : 'Warning' }" />
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</VBox>
		</content>
		<endButton>
			<Button text="{i18n>cerrar}" press=".onCerrarCliente" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>
