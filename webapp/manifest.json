{
	"_version": "1.65.0",
	"sap.app": {
		"id": "com.socopur.cotizador",
		"type": "application",
		"i18n": "i18n/i18n.properties",
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"applicationVersion": {
			"version": "0.1.0"
		},
		"dataSources": {
			"mainService": {
				"uri": "sap/opu/odata4/sap/yui_cotiz_v4/srvd_a2x/sap/yui_cotiz_srv/0001/",
				"type": "OData",
				"settings": {
					"odataVersion": "4.0",
					"localUri": "localService/mainService/metadata.xml"
				}
			}
		},
		"crossNavigation": {
			"inbounds": {
				"Cotizador-display": {
					"semanticObject": "Cotizador",
					"action": "display",
					"title": "{{appTitle}}",
					"subTitle": "{{appDescription}}",
					"signature": {
						"parameters": {},
						"additionalParameters": "allowed"
					}
				}
			}
		}
	},
	"sap.cloud": {
		"public": true,
		"service": "socopur.cotizador"
	},
	"sap.ui": {
		"technology": "UI5",
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": false
		}
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "com.socopur.cotizador.view.App",
			"type": "XML",
			"id": "app",
			"async": true
		},
		"config": {
			"ampliacionCorreo": ""
		},
		"dependencies": {
			"minUI5Version": "1.120.0",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.ui.layout": {},
				"sap.f": {},
				"sap.uxap": {},
				"sap.ui.unified": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "com.socopur.cotizador.i18n.i18n",
					"supportedLocales": [
						"es"
					],
					"fallbackLocale": "es"
				}
			},
			"mock": {
				"type": "sap.ui.model.json.JSONModel",
				"uri": "model/mock.json"
			},
			"odata": {
				"dataSource": "mainService",
				"preload": false,
				"settings": {
					"operationMode": "Server",
					"autoExpandSelect": true,
					"earlyRequests": false,
					"groupId": "$auto"
				}
			}
		},
		"routing": {
			"config": {
				"routerClass": "sap.f.routing.Router",
				"type": "View",
				"viewType": "XML",
				"path": "com.socopur.cotizador.view",
				"controlId": "fcl",
				"transition": "slide",
				"async": true
			},
			"routes": [
				{
					"name": "lista",
					"pattern": "",
					"layout": "OneColumn",
					"target": [
						"lista"
					]
				},
				{
					"name": "nueva",
					"pattern": "oferta/nueva",
					"layout": "MidColumnFullScreen",
					"target": [
						"lista",
						"oferta"
					]
				},
				{
					"name": "vendedores",
					"pattern": "vendedores",
					"layout": "MidColumnFullScreen",
					"target": [
						"lista",
						"vendedores"
					]
				},
				{
					"name": "oferta",
					"pattern": "oferta/{numero}",
					"layout": "MidColumnFullScreen",
					"target": [
						"lista",
						"oferta"
					]
				}
			],
			"targets": {
				"lista": {
					"name": "Main",
					"controlAggregation": "beginColumnPages"
				},
				"oferta": {
					"name": "Oferta",
					"controlAggregation": "midColumnPages"
				},
				"vendedores": {
					"name": "Vendedores",
					"controlAggregation": "midColumnPages"
				}
			}
		}
	}
}
