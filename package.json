{
  "name": "com.socopur.cotizador",
  "version": "0.3.18",
  "private": true,
  "description": "Cotizador Socopur (YCOTIZ) - UI5 Freestyle + TypeScript",
  "scripts": {
    "start": "ui5 serve --open index.html",
    "build": "ui5 build --clean-dest",
    "typecheck": "tsc --noEmit",
    "lint": "ui5lint",
    "gen:types": "node scripts/gen-odata-types.mjs",
    "start:sap": "ui5 serve --config ui5-sap.yaml --open index.html",
    "start:bas": "ui5 serve --config ui5-bas.yaml --port 8080 --accept-remote-connections",
    "build:cf": "node scripts/build-cf.mjs",
    "build:mta": "mbt build",
    "deploy:cf": "cf deploy mta_archives/socopur-cotizador_0.3.18.mtar",
    "build:abap": "node scripts/uri-servicio.mjs absoluta && ui5 build preload --config ui5-build-abap.yaml --clean-dest --dest dist --include-task=generateCachebusterInfo",
    "deploy:abap:prueba": "npm run build:abap && fiori deploy --config ui5-abap.yaml --test --yes",
    "deploy:abap": "npm run build:abap && fiori deploy --config ui5-abap.yaml --yes",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/helpers/registrar.mjs --test \"tests/**/*.test.ts\""
  },
  "devDependencies": {
    "@sapui5/types": "~1.120.52",
    "@ui5/cli": "^4.0.0",
    "@ui5/linter": "^1.0.0",
    "@sap/ux-ui5-tooling": "^1.15.0",
    "typescript": "~5.9.3",
    "ui5-middleware-simpleproxy": "^3.9.0",
    "ui5-task-zipper": "^3.0.0",
    "ui5-tooling-transpile": "^3.0.0"
  }
}
